C4Context
    title System Context Diagram — Consultation Records

    %% Row 1: primary left-to-right flow — no arrows cross within this row
    Person(healthcareAdmin, "Healthcare Administrator", "Manages consultations, registers and logs into the system")
    System_Ext(frontendApp, "Frontend Web Application", "Vite-based SPA running at localhost:5173. Provides the UI for managing consultation records.")
    System(consultationRecords, "Consultation Records API", "Spring Boot REST API. Manages authentication and consultation records using Hexagonal Architecture.")
    System_Ext(mongoAtlas, "MongoDB Atlas", "Cloud-hosted MongoDB database (cluster: atlascluster). Stores users, consultations, consultants, patients, and goals.")

    %% Row 2: referenced entities + planned system — positioned below their related node
    Person(consultant, "Consultant", "Medical professional whose records are tracked")
    Person(patient, "Patient", "Individual receiving consultations")
    System_Ext(emailService, "Email Service", "Planned external email provider for delivering password-reset tokens to users. Not yet implemented.")

    Rel(healthcareAdmin, frontendApp, "Uses", "HTTPS / Browser")
    Rel(frontendApp, consultationRecords, "Calls REST API", "JSON/HTTPS, JWT Bearer Token")
    Rel(consultationRecords, mongoAtlas, "Reads/Writes data", "MongoDB Wire Protocol (TLS)")
    Rel(consultationRecords, emailService, "Sends password reset email [planned]", "SMTP")

    Rel_Back(consultant, consultationRecords, "Consultation records reference")
    Rel_Back(patient, consultationRecords, "Patient records reference")

    UpdateLayoutConfig($c4ShapeInRow="4", $c4BoundaryInRow="1")